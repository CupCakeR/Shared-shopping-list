# Comma-separated "Name:key" pairs. Keys are the only auth, so make them long and random:
#   bun -e 'console.log(crypto.randomUUID())'
USERS=Tom:change-me-1,Partner:change-me-2
DB_PATH=./data/db.sqlite
PORT=3000
# The built client (bun run build), served next to the API.
CLIENT_DIR=./dist
# Push notifications, optional. Generate once with `bunx web-push generate-vapid-keys` and never change them,
# new keys break every existing subscription. Leave all three out to turn push off.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

{
  "name": "shared-shopping-list",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "bun --watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "bun server/src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client && tsc --noEmit -p client/tsconfig.sw.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "hono": "^4.13.8",
    "idb": "^8.0.3",
    "preact": "^10.29.8",
    "simple-icons": "^16.32.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
